import    nelumbo.strings

String  a, b, c

"a"="a"              ? [()][]
"a"!="a"             ? [][()]

"a"="b"              ? [][()]
"a"!="b"             ? [()][]

"foo"+"bar"="baz"    ? [][()]
"foo"+"bar"="foobar" ? [()][]
a+"bar"="foobar"     ? [(a="foo")][..]
"foo"+a="foobar"     ? [(a="bar")][..]
"foo"+"bar"          ? [("foobar")][..]
a+"r"="bar"          ? [(a="ba")][..]
a+"obar"="foobar"    ? [(a="fo")][..]

len("foo")=0 ? [][()]
len("foo")=3 ? [()][]
len(a)=3     ? [..][..]
len("foo")   ? [(3)][..]

int("123456")=123456   ? [()][]
str(123456)="123456"   ? [()][]
int("123457")=123456   ? [][()]
str(123457)="123456"   ? [][()]

str(123456)       ? [("123456")][..]
str(0000123456)   ? [("123456")][..]
int("123456")     ? [(123456)][..]
int("0000123456") ? [(123456)][..]

int("    123456")    ? [][..]
int("123456    ")    ? [][..]
int("NaN")           ? [][..]
int("Hello, World!") ? [][..]
