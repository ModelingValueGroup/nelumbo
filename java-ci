# java as on a CI runner (4 vCPUs, 16 GB), whatever machine this is: the core count sets the
# engine pool (Collection.PARALLELISM = cores - 1) and the JVM's GC and JIT threads, the RAM the
# heap sizes (an explicit -Xmx wins). The test JVMs get the same flags (build.gradle.kts).
# Usage: ./java-ci [jvm options] -jar cli/build/libs/nelumbo-cli-dev.jar file.nl

PINNED="-XX:ActiveProcessorCount=4 -XX:MaxRAM=16g -XX:+UseG1GC"

main() {
    exec java $PINNED "$@"
}

main "$@"
